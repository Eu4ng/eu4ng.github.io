    {
      "type": "table",
      "title": "기기별 최신 값",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT max(time) AS \"마지막 기록\", site AS \"지역\", room AS \"방\", device AS \"기기\",\n  last(temperature, time) FILTER (WHERE temperature IS NOT NULL) AS \"온도\",\n  last(humidity, time) FILTER (WHERE humidity IS NOT NULL) AS \"습도\",\n  last(presence, time) FILTER (WHERE presence IS NOT NULL) AS \"재실\",\n  last(contact, time) FILTER (WHERE contact IS NOT NULL) AS \"닫힘\",\n  last(illuminance, time) FILTER (WHERE illuminance IS NOT NULL) AS \"조도\",\n  last(battery, time) FILTER (WHERE battery IS NOT NULL) AS \"배터리\",\n  last(linkquality, time) FILTER (WHERE linkquality IS NOT NULL) AS \"LQI\",\n  last(model, time) FILTER (WHERE model IS NOT NULL) AS \"모델\",\n  last(vendor, time) FILTER (WHERE vendor IS NOT NULL) AS \"제조사\",\n  last(ieee, time) FILTER (WHERE ieee IS NOT NULL) AS \"IEEE\"\nFROM zigbee2mqtt\nWHERE $__timeFilter(time) AND site IN ($site) AND ('__all__' IN ($room) OR room IN ($room)) AND ('__all__' IN ($device) OR device IN ($device))\nGROUP BY site, room, device\nORDER BY site, room, device"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "선택한 기간에서 기기마다 항목별 마지막 값입니다.",
      "id": 2
    },
    {
