            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, $__interval), device AS metric, avg(temperature) AS value\nFROM zigbee2mqtt\nWHERE $__timeFilter(time) AND temperature IS NOT NULL AND site IN ($site) AND ('__all__' IN ($room) OR room IN ($room)) AND ('__all__' IN ($device) OR device IN ($device))\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
