          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT max(time) AS \"마지막 기록\", site AS \"지역\", model AS \"모델\", vendor AS \"제조사\", serial AS \"시리얼\", node AS \"노드 ID\",\n  count(DISTINCT device) AS \"엔티티 수\"\nFROM hass\nWHERE $__timeFilter(time) AND site IN ($site) AND serial IS NOT NULL AND serial <> ''\nGROUP BY site, model, vendor, serial, node\nORDER BY site, model, serial"
