          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH e AS (\n  SELECT time_bucket('1h', time) AS b, anchor, avg(value) * 3600 AS joule\n  FROM readings WHERE device = 'plug' AND property = 'power' AND anchor IN ('server_ms_a2_1', 'server_k12_1', 'pc_k8_plus_1') AND $__timeFilter(time) GROUP BY 1, 2\n),\nt AS (\n  SELECT time_bucket('1h', time) AS b, CASE server WHEN 'pve01-610m' THEN 'server_ms_a2_1' WHEN 'pve02-780m' THEN 'server_k12_1' WHEN 'winpc-780m' THEN 'pc_k8_plus_1' END AS anchor, sum(prompt_tokens + eval_tokens) AS tokens\n  FROM llm_calls WHERE $__timeFilter(time) GROUP BY 1, 2\n)\nSELECT e.b AS time, e.anchor AS metric, e.joule / nullif(t.tokens, 0) AS value\nFROM e JOIN t USING (b, anchor) WHERE t.tokens > 0 ORDER BY 1"
